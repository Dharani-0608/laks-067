import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import java.io.IOException;

public class ProductHandler implements HttpHandler {

    Product[] products;

    ProductHandler(Product[] products) {
        this.products = products;
    }

    public void handle(HttpExchange exchange) throws IOException {

        StringBuilder json = new StringBuilder("[");

        for (int i = 0; i < products.length; i++) {

            Product p = products[i];

            json.append("{")
                .append("\"id\":").append(p.id).append(",")
                .append("\"name\":\"").append(p.name).append("\",")
                .append("\"category\":\"").append(p.category).append("\",")
                .append("\"price\":").append(p.price).append(",")
                .append("\"icon\":\"").append(p.icon).append("\"}");

            if (i < products.length - 1)
                json.append(",");
        }

        json.append("]");

        ResponseUtil.send(exchange, json.toString());
    }
}