* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f6fa;
}

header {
    background: #111827;
    color: white;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    color: #60a5fa;
}

.cart-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
}

.container {
    padding: 40px;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 25px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 15px #ddd;
}

.icon {
    font-size: 60px;
    margin-bottom: 15px;
}

.card h2 {
    margin-bottom: 10px;
}

.category {
    color: gray;
    margin-bottom: 10px;
}

.price {
    font-size: 22px;
    font-weight: bold;
    margin: 15px;
}

.add-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
}

.add-btn:hover {
    background: #1d4ed8;
}

.section {
    display: none;
    margin-top: 30px;
}

.section.active {
    display: block;
}

.box {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 15px #ddd;
    max-width: 600px;
    margin: auto;
}

.item {
    padding: 15px;
    border-bottom: 1px solid #ddd;
    display: flex;
    justify-content: space-between;
}

.action-btn {
    background: #16a34a;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 20px;
}

.payment-btn {
    background: #7c3aed;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 20px;
}

.success {
    text-align: center;
    padding: 40px;
}

.success h2 {
    color: #16a34a;
    margin-bottom: 15px;
}